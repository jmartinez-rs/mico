{
  "name": "mico-agent",
  "version": "0.1.5",
  "description": "Mico 🐒 - Agente curioso que monitorea commits de Git en tiempo real y documenta las tareas diarias en Markdown.",
  "type": "module",
  "license": "MIT",
  "author": "Jose Martinez",
  "repository": {
    "type": "git",
    "url": "https://github.com/jmartinez-rs/mico.git"
  },
  "homepage": "https://github.com/jmartinez-rs/mico#readme",
  "bugs": {
    "url": "https://github.com/jmartinez-rs/mico/issues"
  },
  "bin": {
    "mico-agent": "./dist/cli.js",
    "mico": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/cli.ts start",
    "build": "node node_modules/typescript/bin/tsc -p tsconfig.json && chmod +x dist/cli.js",
    "start": "node dist/cli.js start",
    "typecheck": "node node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run src/integration/",
    "test:integration:real": "MICO_INTEGRATION_REAL_LLM=1 vitest run src/integration/",
    "calibrate": "tsx src/calibration/run.ts"
  },
  "dependencies": {
    "@octokit/rest": "^22.0.0",
    "dotenv": "^17.0.0",
    "openai": "^6.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
