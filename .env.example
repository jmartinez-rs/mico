# ----------------------------------------------------------------------------
# Mico 🐒 - Agente Curioso de Monitoreo de Commits
# ----------------------------------------------------------------------------
# Intervalo de chequeo de commits en milisegundos (default: 10000ms = 10s)
MICO_WATCH_INTERVAL_MS=10000

# Ruta del repositorio Git local a monitorear (default: ./)
MICO_TARGET_REPO_PATH=./

# Carpeta de salida para los informes Markdown diarios (default: ./docs/mico)
MICO_OUTPUT_DIR=./docs/mico

# Archivo de estado para recordar los commits procesados
MICO_STATE_FILE=./data/mico-state.json

# Token de acceso a la API de GitHub (requerido solo para `mico document`)
GITHUB_TOKEN=

# Proveedor LLM (compatible con la API de OpenAI: Opencode, OpenAI, etc.)
# Base URL del endpoint compatible con OpenAI.
LLM_BASE_URL=https://api.openai.com/v1
# API key del proveedor.
LLM_API_KEY=
# Modelo a utilizar.
LLM_MODEL=gpt-4o-mini

# Carpeta donde se persisten los documentos generados y los digests.
DOCUMENTS_PATH=./data/docs
# Carpeta donde se persiste la memoria consultable de eventos de trabajo.
WORK_EVENTS_PATH=./data/work-events

# ----------------------------------------------------------------------------
# Calibración del gate de confianza (Incremento C).
# Todas son opcionales; los defaults reproducen el comportamiento histórico.
# Ver docs/arquitectura/calibracion-confianza.md.
# ----------------------------------------------------------------------------
# Umbral del gate: score por debajo => se marca "revisión humana".
CONFIDENCE_REVIEW_THRESHOLD=0.5
# Score a partir del cual el nivel es "high".
CONFIDENCE_HIGH_THRESHOLD=0.75
# Longitud mínima (chars) para no penalizar una descripción por breve.
CONFIDENCE_MIN_BODY_LENGTH=30
# Proporción de commits pobres a partir de la cual se penaliza.
CONFIDENCE_POOR_COMMIT_RATIO=0.5
# Pesos de penalización de la heurística (cuánto resta cada señal débil).
CONFIDENCE_WEIGHT_NO_BODY=0.35
CONFIDENCE_WEIGHT_SHORT_BODY=0.15
CONFIDENCE_WEIGHT_NO_COMMITS=0.1
CONFIDENCE_WEIGHT_POOR_COMMITS=0.2
CONFIDENCE_WEIGHT_NO_FILES=0.1
CONFIDENCE_WEIGHT_NO_DIFF=0.1
