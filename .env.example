# Puerto del servidor HTTP
PORT=3000

# Token de acceso a la API de GitHub (repos privados requieren scope repo)
GITHUB_TOKEN=

# Proveedor LLM (compatible con la API de OpenAI: Opencode, OpenAI, etc.)
# Base URL del endpoint compatible con OpenAI.
LLM_BASE_URL=https://api.openai.com/v1
# API key del proveedor.
LLM_API_KEY=
# Modelo a utilizar.
LLM_MODEL=gpt-4o-mini

# Carpeta donde se persisten los documentos generados.
DOCUMENTS_PATH=./data/docs
